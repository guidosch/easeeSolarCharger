# Copy to .env.local and fill in. .env.local is gitignored — committing a secret requires
# rotation, not just removal (Principle V). All values are optional for the fixture-driven tests.

# --- Google Cloud / Firestore -------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=solarpowerconsumptionoptimizer
# Set only for local development; presence of this variable is what makes the SDK talk to the
# emulator instead of production Firestore.
FIRESTORE_EMULATOR_HOST=localhost:8080

# --- Easee ---------------------------------------------------------------------------------
EASEE_API_BASE=https://api.easee.com
# Dedicated technical account used by the optimizer while no user is signed in (Principle V).
EASEE_TECHNICAL_USERNAME=
EASEE_TECHNICAL_PASSWORD=
# Keycloak realm that issues Easee tokens (research R6 / spike O2).
EASEE_ISSUER=https://auth.easee.com/realms/easee
EASEE_JWKS_URL=https://auth.easee.com/realms/easee/protocol/openid-connect/certs
EASEE_AUDIENCE=easee

# --- SolarEdge -----------------------------------------------------------------------------
SOLAREDGE_API_BASE=https://monitoringapi.solaredge.com
SOLAREDGE_API_KEY=
SOLAREDGE_SITE_ID=

# --- OpenWeatherMap ------------------------------------------------------------------------
OPENWEATHER_API_BASE=https://api.openweathermap.org
OPENWEATHER_API_KEY=

# --- Site ----------------------------------------------------------------------------------
# Used for the local sunrise/sunset calculation that gates the SolarEdge call (research R3).
SITE_LATITUDE=47.3769
SITE_LONGITUDE=8.5417

# --- Admin surface -------------------------------------------------------------------------
# Single shared basic-auth credential (constitution, Technology & Deployment Constraints).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Services ------------------------------------------------------------------------------
API_PORT=8081
OPTIMIZER_PORT=8082
# Bumped on any behavioural change to packages/core; recorded in every cycle (Principle III).
SCHEDULER_VERSION=1.0.0
